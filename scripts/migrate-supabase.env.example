# העתק לקובץ מחוץ לריפו (למשל ~/supabase-migrate.env), מלא ערכים, והרץ: set -a; source ~/supabase-migrate.env; set +a
# אל תדביק את הערכים בצ'אט ואל תעלה את הקובץ לגיט.

# מחרוזות חיבור: Supabase > Connect > Session pooler (או Direct connection). כוללות את סיסמת המסד.
OLD_DATABASE_URL="postgresql://postgres.OLDREF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
NEW_DATABASE_URL="postgresql://postgres.NEWREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# כתובות הפרויקטים: Project Settings > API > Project URL
OLD_SUPABASE_URL="https://OLDREF.supabase.co"
NEW_SUPABASE_URL="https://NEWREF.supabase.co"

# מפתחות service_role: Project Settings > API (לשלב התמונות ולבדיקת הספירה בלבד)
OLD_SERVICE_KEY=""
NEW_SERVICE_KEY=""
