# ── Server ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ipage
PORT=3000

# ── Supabase (backend) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Service-role key — REQUIRED. The backend uses this (not the publishable key
# above) for every DB read/write, which is what lets RLS stay locked deny-all
# (migration 007) while the app still works. Missing/wrong value here does
# not break silently — falls back to the anon key, which RLS then denies
# everything to (fails safe, but the app will look broken).
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must be the real production origin (e.g. https://pagey.co.il) once deployed.
# Fails CLOSED in production if unset — see src/app.ts.
CORS_ORIGIN=
NODE_ENV=production

# ── Payments (SUMIT) ──────────────────────────────────────────────────────────
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
# Where SUMIT redirects the browser back after checkout, and the backend's own
# public base URL for its return handler — see src/controllers/payment.controller.ts.
PUBLIC_APP_URL=https://pagey.co.il
PUBLIC_API_URL=https://api.pagey.co.il

# ── AI — text generation (Anthropic) ─────────────────────────────────────────
# If missing, mock content is returned instead of calling the API
ANTHROPIC_API_KEY=

# ── AI — image generation (fal.ai) ───────────────────────────────────────────
FAL_KEY=

# ── Stock images (Unsplash) ───────────────────────────────────────────────────
UNSPLASH_API_KEY=

# ── Email — transactional mail (Resend) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@yourdomain.co.il

# ── Admin panel ───────────────────────────────────────────────────────────────
# Shared secret required (as the `x-admin-password` header) on every
# /api/admin/* request, ON TOP of a real Supabase login with
# user_profiles.is_admin = true. The admin dashboard prompts for it and keeps it
# in sessionStorage for the tab's lifetime.
# FAILS CLOSED: if this is unset the server rejects every admin request and logs
# a warning — a forgotten value breaks the admin panel loudly instead of
# silently disabling the gate.
ADMIN_PANEL_PASSWORD=
