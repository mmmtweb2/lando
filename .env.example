# ── Server ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ipage
PORT=3000

# ── Supabase (backend) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Service-role key — REQUIRED. The backend uses this (not the publishable key
# above) for every DB read/write, which is what lets RLS stay locked deny-all
# (migration 007) while the app still works. Missing/wrong value here does
# not break silently — falls back to the anon key, which RLS then denies
# everything to (fails safe, but the app will look broken).
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must be the real production origin (e.g. https://pagey.co.il) once deployed.
# Fails CLOSED in production if unset — see src/app.ts.
CORS_ORIGIN=
NODE_ENV=production

# ── Payments (SUMIT) ──────────────────────────────────────────────────────────
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
# Where SUMIT redirects the browser back after checkout, and the backend's own
# public base URL for its return handler — see src/controllers/payment.controller.ts.
PUBLIC_APP_URL=https://pagey.co.il
PUBLIC_API_URL=https://api.pagey.co.il

# ── AI — text generation (Anthropic) ─────────────────────────────────────────
# If missing, mock content is returned instead of calling the API
ANTHROPIC_API_KEY=

# ── AI — image generation (fal.ai) ───────────────────────────────────────────
FAL_KEY=

# ── Stock images (Unsplash) ───────────────────────────────────────────────────
UNSPLASH_API_KEY=

# ── Email — transactional mail (Resend) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@yourdomain.co.il

# Internal alert recipient — where the "new user signed up" email goes.
# Defaults to the founder's personal address in code if unset (see
# src/services/signup.mailer.ts); set explicitly to override.
ADMIN_ALERT_EMAIL=

# ── Admin panel ───────────────────────────────────────────────────────────────
# Shared secret required (as the `x-admin-password` header) on every
# /api/admin/* request, ON TOP of a real Supabase login with
# user_profiles.is_admin = true. The admin dashboard prompts for it and keeps it
# in sessionStorage for the tab's lifetime.
# FAILS CLOSED: if this is unset the server rejects every admin request and logs
# a warning — a forgotten value breaks the admin panel loudly instead of
# silently disabling the gate.
ADMIN_PANEL_PASSWORD=

# ── Google promotion product (SEO autopilot) ─────────────────────────────────
# Google Places API (New) key — Audit, competitor comparison, reviews widget.
# Without it the Places features answer "not configured".
GOOGLE_PLACES_API_KEY=

# Public Audit page (/audit). OFF until PUBLIC_AUDIT_DAILY_CAP is a positive number
# (unset/0 → HTTP 503). Max audits per UTC day for ALL visitors; searches are capped
# at 8x this. Every audit costs Google Places calls — start low (e.g. 50-100).
PUBLIC_AUDIT_DAILY_CAP=
# Max stored leads per UTC day from the public Audit form (default 300).
AUDIT_LEAD_DAILY_CAP=
# Random string used to salt the hash of visitor IPs stored with a lead. Set once, keep stable.
AUDIT_IP_SALT=
# WhatsApp number for the "Concierge" button — digits only, with country code
# (e.g. 972501234567). Without it the button is hidden.
CONCIERGE_WHATSAPP=

# External-site lead tracking: max tracked events per business per day (default 2000).
SEO_TRACK_DAILY_CAP=

# Monthly subscription (SUMIT standing order). OFF unless SEO_SUBSCRIPTION_ENABLED=true.
# Run migration 030 first. Use SEO_PLAN_PRICE=1 for the first real test charge.
SEO_SUBSCRIPTION_ENABLED=false
SEO_PLAN_PRICE=
SEO_PLAN_NAME=
# Random string; SUMIT's trigger calls /api/seo/subscription/webhook?secret=<this>.
SEO_SUBSCRIPTION_WEBHOOK_SECRET=
